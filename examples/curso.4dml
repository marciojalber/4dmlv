# Define a estrutura "curso"
obj Curso ini
    titulo          TipoTexto       @obrigatorio
    totVagas        TipoInteiro     @obrigatorio
    prazoInscricoes TipoData        @obrigatorio
fim

# Define a estrutura "Avaliação de reação"
obj AvReacao ini
    textoAbertura   TipoTexto       @obrigatorio
fim

# Define a estrutura "Quesito da avaliação de reação"
obj AvReacaoQuesito ini
    assunto         TipoTexto       @obrigatorio
    criterios       TipoTexto       @obrigatorio
    quesitoObjetivo TipoBoleano     @obrigatorio
    opcoes          TipoLista
    tamanhoRespSubj TipoInteiro
fim

curso = obj.Curso{
    titulo: ""
    totVagas: -2000
    preco: -2.000
    prazoInscricoes: data("20/10/2026")
}

av_reacao = obj.AvReacao{
    textoAbertura: "Este curso visa ensinar os peritos médicos"
}
